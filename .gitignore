# Ignore intermediate build files
Intermediate/

# Ignore saved data
Saved/

# Ignore compiled binaries
Binaries/

# Ignore Potential Assets List
Assets/

# Ignore logs
Logs/

# Ignore derived data cache
DerivedDataCache/

# Ignore project files
*.uproject.*

# Ignore user-specific settings
*.sln.DotSettings.user
*.suo
*.userprefs

# Ignore Rider IDE files
.idea/

# Claude Code worktrees live inside .claude/ — the rest of .claude/ (WORKFLOW.md,
# rules/, agents/) is deliberately tracked. Each worktree holds a .git file, so
# without this git treats it as a nested repo and tries to record a gitlink.
.claude/worktrees/

# Per-user scratch content: EXP-lane assets, throwaway maps, tuning variants.
# Ignored so it costs nothing in LFS, which is cumulative and permanent.
# Committed test fixtures do NOT go here — functional test maps live in
# Content/Maps/Tests/ so CI can run them.
Content/Developers/

# Ignore macOS specific files
.DS_Store

# Ignore Windows specific files
Thumbs.db

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.slnx
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Builds
Build/*

# Built data for maps
*_BuiltData.uasset

#Keys Etc.
LocalEngine.ini
.sentry-native/

# Third-party plugins: reinstalled per engine version; kept out of source control to limit repo/LFS bloat
/Plugins/5.6_CollisionCommander_1.3/
/Plugins/sentry-unreal-1.0.0-beta.7-engine5.4-github/
